{
  "name": "rantai",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/desktop && bun run dev",
    "build": "cd apps/desktop && bun run build",
    "build:ui": "cd apps/ui && bun run build",
    "typecheck": "cd apps/ui && bun run typecheck",
    "rust:fmt": "cd apps/desktop/src-tauri && cargo fmt --check",
    "rust:lint": "cd apps/desktop/src-tauri && cargo clippy --all-targets -- -D warnings",
    "rust:test": "cd apps/desktop/src-tauri && cargo test",
    "test": "cd apps/ui && bun test",
    "sidecar": "cd apps/desktop && bun run sidecar"
  }
}
