{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rantai",
  "version": "0.0.1",
  "identifier": "com.people62.rantai",
  "build": {
    "frontendDist": "../../ui/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": {
      "cwd": "../../ui",
      "script": "bun run dev",
      "wait": false
    }
  },
  "app": {
    "windows": [
      {
        "label": "utama",
        "title": "Rantai",
        "width": 1100,
        "height": 760,
        "minWidth": 680,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
