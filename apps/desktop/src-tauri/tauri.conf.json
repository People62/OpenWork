{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rantai",
  "version": "0.0.1",
  "identifier": "com.people62.rantai",
  "build": {
    "frontendDist": "../../ui/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": {
      "cwd": "../../ui",
      "script": "bun run dev",
      "wait": false
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rantai",
        "width": 1100,
        "height": 760,
        "minWidth": 680,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "openwork"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5QzEzOTlGOTVDNkY4RTQKUldUaytNYVZuem5CdWFqRVpzSjZwK1VTN25QdERNVnoyWktrNVFUQWNqdWJ0dHBxakJkek9MWXcK",
      "endpoints": [
        "https://github.com/People62/OpenWork/releases/latest/download/latest.json"
      ]
    }
  }
}
